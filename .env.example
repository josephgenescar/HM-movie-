# Public — sûres à exposer côté client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — serveur uniquement, jamais exposé au frontend
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — server only, never expose these in client code
AI_TEXT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Video generation through Replicate (server only)
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=minimax/video-01
REPLICATE_IMAGE_VIDEO_MODEL=stability-ai/stable-video-diffusion

