OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Add the video provider credentials when selected.
VIDEO_AI_API_KEY=
VIDEO_AI_API_URL=

